  after: {fileID: 0}
  lines:
  - speaker: "\uAD00\uCE21\uD300 (\uBB34\uC804)"
    text: "SITE-0 \uAD00\uCE21\uD300\uC785\uB2C8\uB2E4. \uAC70\uC810 \uC9C4\uC785\uC744
